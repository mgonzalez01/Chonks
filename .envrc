use flake

# Project-local PATH additions
PATH_add ./mcp-server/node_modules/.bin
PATH_add ./.venv/bin

# Default chonks endpoints — override per-shell as needed
export CHONKS_URL="${CHONKS_URL:-http://localhost:11438}"
export CHONKS_DB="${CHONKS_DB:-$PWD/.db/chonks.db}"
export CHONKS_CONFIG="${CHONKS_CONFIG:-$PWD/config.json}"
