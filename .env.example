# docker compose settings — copy to .env (gitignored)
CHONKS_MCP_PORT=11439
CHONKS_MCP_BIND=127.0.0.1  # 0.0.0.0 to serve the LAN; there is no authentication, trusted networks only
CHONKS_MCP_ALLOWED_HOSTS=  # required when CHONKS_MCP_BIND is not loopback: comma-separated hostnames/IPs clients will use (Host-header allowlist)
CHONKS_DATA=./data         # holds chonks.db + config.json (embed_url must be reachable from inside the container)
CHONKS_ALLOW_DEGRADED=     # 1 = serve keyword-only when the embedder probe fails instead of refusing to start
CHONKS_SOURCE=             # only for `--profile index`: host path of the codebase
CHONKS_EMBED_HF_REPO=      # only for `--profile embedder`: GGUF repo, e.g. jinaai/jina-code-embeddings-0.5b-GGUF
CHONKS_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server   # NVIDIA: ghcr.io/ggml-org/llama.cpp:server-cuda (+ uncomment `gpus: all`)
CHONKS_EMBED_PARALLEL=8
CHONKS_EMBED_BATCH=128                                  # only for `--profile index`: 32 with the CPU embedder profile (128-chunk batches hit the 120s request timeout)
CHONKS_EMBED_CTX=32768                                  # keep CTX/PARALLEL >= 4096 tokens (largest chunk, dense code)
CHONKS_LLAMA_EXTRA=                                     # e.g. "-ngl 99" on the cuda image
